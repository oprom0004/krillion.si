---
interface Props {
  initialMode?: 'daily' | 'endless' | 'lobby';
}

const { initialMode = 'daily' } = Astro.props;
---

<div id="krillion-arena" class="relative w-full max-w-5xl mx-auto rounded-3xl bg-abyss-card/95 border border-white/10 p-3 sm:p-6 backdrop-blur-xl shadow-2xl shadow-black/80">
  <!-- Game Mode Controls & Direct Launchers -->
  <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-white/10">
    <!-- Main Direct Play Modes -->
    <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 bg-abyss-dark/80 p-1.5 rounded-2xl border border-white/5">
      <button
        id="btn-play-daily"
        class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all bg-abyss-cyan text-abyss-dark shadow-lg shadow-abyss-cyan/20 flex items-center gap-1.5"
      >
        <span>⚡ Daily Dive (Direct Play)</span>
      </button>
      <button
        id="btn-play-endless"
        class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all text-slate-400 hover:text-white flex items-center gap-1.5"
      >
        <span>♾️ Endless Mode</span>
      </button>
      <button
        id="btn-play-lobby"
        class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all text-slate-400 hover:text-white flex items-center gap-1.5"
      >
        <span>🗂️ Packs & Themes</span>
      </button>
    </div>

    <!-- Quick Status / Badge / Fullscreen -->
    <div class="flex items-center gap-2 sm:gap-3 text-xs">
      <span class="text-emerald-400 hidden sm:flex items-center gap-1 font-mono text-[11px]">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Instant Engine
      </span>
      <button
        id="btn-fullscreen-toggle"
        class="text-slate-300 hover:text-white px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-semibold flex items-center gap-1 transition-all"
      >
        <span>⛶</span> Fullscreen
      </button>
    </div>
  </div>

  <!-- Direct Game Viewport -->
  <div class="w-full mt-4">
    <div
      id="game-frame-container"
      class="relative w-full rounded-2xl overflow-hidden border border-cyan-500/30 bg-[#030814] shadow-2xl transition-all"
      style="height: clamp(620px, 80vh, 850px);"
    >
      <iframe
        id="krillion-direct-frame"
        src="https://www.krillion.org/play/daily/"
        title="Krillion Direct Game Viewport"
        class="w-full h-full border-0 bg-[#030814]"
        allow="fullscreen; clipboard-write; autoplay"
        loading="eager"
      ></iframe>
    </div>

    <!-- Quick Footer Bar under Game -->
    <div class="mt-3 flex flex-wrap items-center justify-between text-xs text-slate-400 px-1 gap-2">
      <div class="flex items-center gap-2">
        <span class="text-abyss-cyan font-semibold">Active Mode:</span>
        <span id="label-active-mode" class="text-slate-200 font-mono">Today's 7-Question Daily Dive</span>
      </div>
      <div class="flex items-center gap-3">
        <a href="/how-to-dive-7000m" class="text-slate-400 hover:text-abyss-cyan transition-colors underline">
          7,000m Strategy
        </a>
        <span class="text-slate-600">•</span>
        <a href="https://krillionhints.com" target="_blank" rel="noopener" class="text-amber-400 hover:text-amber-300 font-semibold underline">
          Today's Hints & Solver ↗
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const btnDaily = document.getElementById('btn-play-daily');
  const btnEndless = document.getElementById('btn-play-endless');
  const btnLobby = document.getElementById('btn-play-lobby');
  const frame = document.getElementById('krillion-direct-frame') as HTMLIFrameElement;
  const labelMode = document.getElementById('label-active-mode');
  const btnFullscreen = document.getElementById('btn-fullscreen-toggle');
  const frameContainer = document.getElementById('game-frame-container');

  const modes = [
    { id: 'daily', url: 'https://www.krillion.org/play/daily/', btn: btnDaily, label: "Today's 7-Question Daily Dive" },
    { id: 'endless', url: 'https://www.krillion.org/play/endless/', btn: btnEndless, label: 'Endless Trench Dive (Unlimited)' },
    { id: 'lobby', url: 'https://www.krillion.org/play/', btn: btnLobby, label: 'Themes & Expansion Packs Lobby' },
  ];

  function setGameMode(modeId: string) {
    const target = modes.find(m => m.id === modeId) || modes[0];

    modes.forEach(m => {
      m.btn?.classList.remove('bg-abyss-cyan', 'text-abyss-dark', 'shadow-lg', 'shadow-abyss-cyan/20');
      m.btn?.classList.add('text-slate-400');
    });

    target.btn?.classList.add('bg-abyss-cyan', 'text-abyss-dark', 'shadow-lg', 'shadow-abyss-cyan/20');
    target.btn?.classList.remove('text-slate-400');

    if (frame && frame.src !== target.url) {
      frame.src = target.url;
    }

    if (labelMode) {
      labelMode.textContent = target.label;
    }
  }

  btnDaily?.addEventListener('click', () => setGameMode('daily'));
  btnEndless?.addEventListener('click', () => setGameMode('endless'));
  btnLobby?.addEventListener('click', () => setGameMode('lobby'));

  btnFullscreen?.addEventListener('click', () => {
    if (frameContainer?.requestFullscreen) {
      frameContainer.requestFullscreen();
    } else if (frame?.requestFullscreen) {
      frame.requestFullscreen();
    }
  });

  // Check current URL pathname to set default
  const path = window.location.pathname;
  if (path.includes('endless')) {
    setGameMode('endless');
  } else {
    setGameMode('daily');
  }
</script>
