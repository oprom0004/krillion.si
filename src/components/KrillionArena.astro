---
interface Props {
  modeUrl?: string;
  modeTitle?: string;
  badgeText?: string;
  statusText?: string;
  showHints?: boolean;
}

const {
  modeUrl = 'https://www.krillion.org/play/daily/',
  modeTitle = 'Krillion Trench Arena',
  badgeText = 'DAILY DIVE ⚓',
  statusText = 'UPLINK: ONLINE',
  showHints = true
} = Astro.props;
---

<div class="space-y-2" id="krillion-arena-wrapper">
  <!-- Submarine Command Bar / Controls -->
  <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 rounded-2xl bg-abyss-card/90 border border-cyan-500/20 backdrop-blur-md text-xs shadow-lg">
    <!-- Left: Status Indicator & Active Mode Badge -->
    <div class="flex items-center gap-3">
      <span class="flex items-center gap-1.5 font-mono text-[11px] text-emerald-400">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>{statusText}</span>
      </span>
      <span class="hidden sm:inline-block w-px h-3 bg-white/10"></span>
      <span id="arena-mode-badge" class="px-2.5 py-0.5 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-400 font-bold text-[10px] tracking-wide uppercase transition-all">
        {badgeText}
      </span>
      <span class="hidden sm:inline-block w-px h-3 bg-white/10"></span>
      <div class="inline-flex rounded-xl bg-black/40 border border-white/10 p-0.5 text-[10px] font-mono">
        <button
          type="button"
          id="btn-mode-native"
          class="px-2.5 py-1 rounded-lg bg-cyan-400 text-slate-950 font-bold transition shadow cursor-pointer"
          data-url="/endless-game/"
          data-badge="INSTANT PLAY • 7 PROMPTS ⚓"
        >
          ⚓ Endless (Instant)
        </button>
        <button
          type="button"
          id="btn-mode-daily"
          class="px-2.5 py-1 rounded-lg text-slate-300 hover:text-white transition cursor-pointer"
          data-url="https://www.krillion.org/play/daily/"
          data-badge="DAILY DIVE • 00:00 UTC 🌐"
        >
          🌐 Daily Dive
        </button>
      </div>
    </div>

    <!-- Right: Quick Interactive Controls -->
    <div class="flex items-center gap-2">
      <button
        id="btn-reload-game"
        type="button"
        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 transition-colors text-[11px] font-medium cursor-pointer"
        title="Reload Game Frame"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
          <path d="M3 3v5h5" />
          <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
          <path d="M16 21h5v-5" />
        </svg>
        <span>Reload</span>
      </button>

      <button
        id="btn-fullscreen-game"
        type="button"
        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 transition-colors text-[11px] font-bold cursor-pointer"
        title="Toggle Fullscreen"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M8 3H5a2 2 0 0 0-2 2v3" />
          <path d="M21 8V5a2 2 0 0 0-2-2h-3" />
          <path d="M3 16v3a2 2 0 0 0 2 2h3" />
          <path d="M16 21h3a2 2 0 0 0 2-2v-3" />
        </svg>
        <span>Fullscreen</span>
      </button>
    </div>
  </div>

  <!-- Game Canvas Container -->
  <div
    id="game-frame-container"
    class="relative w-full rounded-2xl overflow-hidden border border-cyan-500/30 bg-[#030814] shadow-[0_0_35px_rgba(6,182,212,0.12)] ring-1 ring-cyan-500/20"
    style="height: clamp(620px, 86vh, 880px);"
  >
    <iframe
      id="krillion-direct-frame"
      src={modeUrl}
      title={modeTitle}
      class="w-full h-full border-0 bg-[#030814]"
      allow="fullscreen; clipboard-write; autoplay"
      loading="eager"
    ></iframe>
  </div>
</div>

<script>
  const container = document.getElementById('game-frame-container');
  const iframe = document.getElementById('krillion-direct-frame') as HTMLIFrameElement;
  const reloadBtn = document.getElementById('btn-reload-game');
  const fullScreenBtn = document.getElementById('btn-fullscreen-game');
  const badgeEl = document.getElementById('arena-mode-badge');
  const btnNative = document.getElementById('btn-mode-native');
  const btnDaily = document.getElementById('btn-mode-daily');

  if (btnNative && btnDaily && iframe && badgeEl) {
    btnNative.addEventListener('click', () => {
      const url = btnNative.getAttribute('data-url') || '/endless-game/';
      const badge = btnNative.getAttribute('data-badge') || 'INSTANT PLAY ⚓';
      iframe.src = url;
      badgeEl.textContent = badge;
      btnNative.className = 'px-2.5 py-1 rounded-lg bg-cyan-400 text-slate-950 font-bold transition shadow cursor-pointer';
      btnDaily.className = 'px-2.5 py-1 rounded-lg text-slate-300 hover:text-white transition cursor-pointer';
    });
    btnDaily.addEventListener('click', () => {
      const url = btnDaily.getAttribute('data-url') || 'https://www.krillion.org/play/daily/';
      const badge = btnDaily.getAttribute('data-badge') || 'DAILY DIVE 🌐';
      iframe.src = url;
      badgeEl.textContent = badge;
      btnDaily.className = 'px-2.5 py-1 rounded-lg bg-cyan-400 text-slate-950 font-bold transition shadow cursor-pointer';
      btnNative.className = 'px-2.5 py-1 rounded-lg text-slate-300 hover:text-white transition cursor-pointer';
    });
  }

  if (reloadBtn && iframe) {
    reloadBtn.addEventListener('click', () => {
      const currentSrc = iframe.src;
      iframe.src = 'about:blank';
      setTimeout(() => {
        iframe.src = currentSrc;
      }, 50);
    });
  }

  if (fullScreenBtn && container) {
    fullScreenBtn.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        container.requestFullscreen().catch(err => {
          console.error(`Fullscreen request failed: ${err.message}`);
        });
      } else {
        document.exitFullscreen();
      }
    });
  }

  // Global switch function for homepage Quick Play buttons
  (window as any).switchKrillionArena = function(url: string, badgeName: string) {
    if (iframe && url) {
      if (iframe.src !== url) {
        iframe.src = url;
      }
      if (badgeEl && badgeName) {
        badgeEl.textContent = badgeName;
      }
      const target = document.getElementById('game') || container;
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  };

  // Wire all quick play buttons on the page
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest('[data-switch-mode]');
    if (btn) {
      e.preventDefault();
      const url = btn.getAttribute('data-switch-mode') || '';
      const badge = btn.getAttribute('data-badge-name') || '';
      (window as any).switchKrillionArena?.(url, badge);
    }
  });
</script>
