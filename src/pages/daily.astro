---
import Layout from '../layouts/Layout.astro';
import KrillionArena from '../components/KrillionArena.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Daily Abyss Dive' }
];

const dailyFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does the Krillion Daily Dive work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Daily Dive presents all global players with the exact same 7 prompts. You have 20 seconds per prompt to enter a single valid answer. Your score is your total depth in meters accumulated across the 7 rounds (maximum 7,000m)."
      }
    },
    {
      "@type": "Question",
      "name": "What time does the Daily Dive refresh?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The game resets daily at 00:00 UTC (Midnight Universal Time)."
      }
    }
  ]
};
---

<Layout
  title="Play Krillion Daily Dive | Official Daily Trench Challenge - Krillion.si"
  description="Play today's official Krillion daily dive. 7 challenging prompts across global categories. Test your score against today's global trench depth rankings."
  schema={dailyFaqSchema}
>
  <div class="py-6 px-3 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-6">
    <div class="space-y-3">
      <Breadcrumb items={breadcrumbs} />

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-2">
        <div class="space-y-1.5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-400 text-xs font-bold font-mono">
            <span>OFFICIAL DAILY PROMPT SET (7 ROUNDS)</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
            Krillion Daily Abyss Dive
          </h1>
          <p class="text-slate-400 text-xs sm:text-sm max-w-2xl leading-relaxed">
            7 synchronized daily prompts. Evade the crowd traps, calculate rarity, and plunge toward the 7,000-meter Hadal trench.
          </p>
        </div>

        <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-center p-3 rounded-2xl bg-abyss-card border border-cyan-500/20 text-right">
          <span class="text-[10px] text-slate-400 font-mono uppercase tracking-wider">Reset Frequency</span>
          <span class="text-lg font-black text-cyan-400 font-mono">Daily 00:00 UTC</span>
        </div>
      </div>
    </div>

    <!-- Direct Arena -->
    <KrillionArena
      modeUrl="https://www.krillion.org/play/daily/"
      modeTitle="Krillion Daily Abyss Dive"
      badgeText="DAILY DIVE (7 ROUNDS) ⚓"
    />

    <!-- Quick Strategy Guide Banner -->
    <div class="p-6 rounded-3xl bg-abyss-card border border-white/10 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="space-y-1 text-center md:text-left">
        <h3 class="text-base font-bold text-white">Need help on today's specific categories?</h3>
        <p class="text-xs text-slate-400">Read the 7,000m Hadal Playbook or consult KrillionHints.com for spoiler-safe hints.</p>
      </div>
      <div class="flex items-center gap-3">
        <a href="/how-to-dive-7000m" class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-white text-xs font-bold border border-white/10 transition-colors">
          Strategy Guide
        </a>
        <a href="https://krillionhints.com" target="_blank" rel="noopener" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-black transition-colors">
          Today's Hints ↗
        </a>
      </div>
    </div>
  </div>
</Layout>
