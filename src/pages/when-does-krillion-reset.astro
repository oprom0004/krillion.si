---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Reset Countdown & Timezones' }
];

const resetFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What time does Krillion reset daily?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The official Krillion Daily Dive resets globally every day at 00:00 UTC (Midnight Universal Time). In the United States, this corresponds to 8:00 PM EDT (or 7:00 PM EST) and 5:00 PM PDT (or 4:00 PM PST)."
      }
    },
    {
      "@type": "Question",
      "name": "Can you play prior day Krillion games?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The official daily dive only offers the current active 24-hour set. However, you can play unlimited previous-style rounds anytime in Endless Practice Mode or through the 6 Themed Packs."
      }
    }
  ]
};
---

<Layout
  title="When Does Krillion Reset? Daily Midnight Schedule & Reset Countdown - Krillion.si"
  description="What time does Krillion reset? View live countdown to the next daily Krillion puzzle across UTC, EST, PST, GMT, and JST time zones. Don't wait—play Endless mode now!"
  schema={resetFaqSchema}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 prose prose-invert prose-cyan">
    <div class="not-prose mb-8 space-y-3">
      <Breadcrumb items={breadcrumbs} />
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-400 text-xs font-bold font-mono">
        <span>GLOBAL SYNCHRONIZATION SCHEDULE</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white leading-tight">
        When Does Krillion Reset? Live Countdown & Timezones
      </h1>
      <p class="text-slate-400 text-xs sm:text-sm">
        Published by Krillion Strategy Guild • Updated 2026 • 4 min read
      </p>
    </div>

    <!-- Live Countdown Widget -->
    <div class="my-8 p-8 rounded-3xl bg-abyss-card border border-cyan-500/40 text-center not-prose shadow-2xl shadow-cyan-950/30">
      <div class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 font-mono">Next Daily Dive Unlocks In</div>
      <div id="reset-countdown" class="font-mono text-4xl sm:text-6xl font-black text-cyan-400 my-3 tracking-wider">
        --:--:--
      </div>
      <div class="text-xs text-slate-400">
        Official Daily Reset occurs globally at <span class="text-white font-bold">Midnight (00:00 UTC)</span>
      </div>

      <!-- Skip the wait CTA -->
      <div class="mt-6 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-center gap-3">
        <span class="text-xs text-slate-300">Don't want to wait for tomorrow's reset?</span>
        <a
          href="/endless"
          class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-400 to-blue-500 text-slate-950 font-black text-xs sm:text-sm hover:scale-105 active:scale-95 transition-all shadow-md"
        >
          Play Endless Mode Instantly ♾️
        </a>
      </div>
    </div>

    <h2>Krillion Reset Time Across Global Timezones</h2>
    <p>
      The official Krillion daily puzzle synchronized roll-over takes place at <strong>00:00 UTC (Coordinated Universal Time)</strong>. Check your regional local time below:
    </p>

    <div class="not-prose my-6 overflow-x-auto">
      <table class="w-full text-xs text-left bg-abyss-card rounded-2xl border border-white/10 overflow-hidden">
        <thead class="bg-white/5 uppercase text-slate-400 font-mono">
          <tr>
            <th class="p-3">Region</th>
            <th class="p-3">Time Zone</th>
            <th class="p-3">Local Reset Time</th>
            <th class="p-3">Timing Note</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5 font-mono">
          <tr>
            <td class="p-3 font-semibold text-white font-sans">Universal Time</td>
            <td class="p-3 text-cyan-400">UTC / GMT</td>
            <td class="p-3 text-white font-bold">00:00 (Midnight)</td>
            <td class="p-3 text-slate-400 font-sans">Official Master Clock</td>
          </tr>
          <tr>
            <td class="p-3 font-semibold text-white font-sans">US Eastern</td>
            <td class="p-3 text-cyan-400">EDT / EST</td>
            <td class="p-3 text-white font-bold">8:00 PM / 7:00 PM</td>
            <td class="p-3 text-slate-400 font-sans">Evening before UTC date</td>
          </tr>
          <tr>
            <td class="p-3 font-semibold text-white font-sans">US Pacific</td>
            <td class="p-3 text-cyan-400">PDT / PST</td>
            <td class="p-3 text-white font-bold">5:00 PM / 4:00 PM</td>
            <td class="p-3 text-slate-400 font-sans">Late afternoon before UTC date</td>
          </tr>
          <tr>
            <td class="p-3 font-semibold text-white font-sans">United Kingdom</td>
            <td class="p-3 text-cyan-400">BST / GMT</td>
            <td class="p-3 text-white font-bold">1:00 AM / 00:00</td>
            <td class="p-3 text-slate-400 font-sans">Early night / Midnight</td>
          </tr>
          <tr>
            <td class="p-3 font-semibold text-white font-sans">Central Europe</td>
            <td class="p-3 text-cyan-400">CEST / CET</td>
            <td class="p-3 text-white font-bold">2:00 AM / 1:00 AM</td>
            <td class="p-3 text-slate-400 font-sans">Early morning</td>
          </tr>
          <tr>
            <td class="p-3 font-semibold text-white font-sans">Japan / Korea</td>
            <td class="p-3 text-cyan-400">JST / KST</td>
            <td class="p-3 text-white font-bold">9:00 AM</td>
            <td class="p-3 text-slate-400 font-sans">Morning of UTC date</td>
          </tr>
          <tr>
            <td class="p-3 font-semibold text-white font-sans">Australia (Sydney)</td>
            <td class="p-3 text-cyan-400">AEST / AEDT</td>
            <td class="p-3 text-white font-bold">10:00 AM / 11:00 AM</td>
            <td class="p-3 text-slate-400 font-sans">Midday of UTC date</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- FAQ Section -->
    <div class="p-6 sm:p-8 rounded-3xl bg-abyss-card border border-white/10 space-y-4 not-prose my-8">
      <h2 class="text-xl font-bold text-white">Frequently Asked Questions</h2>
      <div class="space-y-4 pt-2">
        {resetFaqSchema.mainEntity.map(faq => (
          <div class="p-4 rounded-2xl bg-white/5 border border-white/5 space-y-2">
            <h3 class="text-sm font-bold text-cyan-300">{faq.name}</h3>
            <p class="text-xs text-slate-300 leading-relaxed">{faq.acceptedAnswer.text}</p>
          </div>
        ))}
      </div>
    </div>
  </article>

  <script>
    function updateCountdown() {
      const now = new Date();
      const nextReset = new Date(Date.UTC(
        now.getUTCFullYear(),
        now.getUTCMonth(),
        now.getUTCDate() + 1,
        0, 0, 0
      ));

      const diff = nextReset.getTime() - now.getTime();
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      const el = document.getElementById('reset-countdown');
      if (el) {
        el.textContent = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
      }
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>
</Layout>
