---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found | Krillion" description="Page not found.">
  <div class="max-w-xl mx-auto text-center py-20 px-4">
    <h1 class="text-6xl font-black text-ocean-primary mb-4">404</h1>
    <h2 class="text-2xl font-bold mb-4">Lost in the Deep Ocean</h2>
    <p class="text-gray-400 mb-8">The depth or coordinate you are trying to reach does not exist.</p>
    <a href="/" class="inline-block px-6 py-3 bg-ocean-primary hover:bg-ocean-hover text-white font-bold rounded-xl transition-all shadow-lg shadow-ocean-primary/25">
      Return to Surface (Home)
    </a>
  </div>
</BaseLayout>
