---
import Layout from '../layouts/Layout.astro';
import KrillionArena from '../components/KrillionArena.astro';
---

<Layout
  title="Play Krillion Science & Chemistry Pack | Periodic Elements Trivia - Krillion.si"
  description="Play Krillion's Science & Chemistry themed pack. Guess rare transition metals, deep-sea hadal species, and obscure Nobel laureates in Physics."
>
  <div class="py-6 px-3 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-6">
    <div class="text-center space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/40 border border-cyan-500/30 text-abyss-cyan text-xs font-bold">
        <span>🧪 THEMED PACK • SCIENCE & CHEMISTRY</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Krillion Science & Chemistry Pack
      </h1>
      <p class="text-slate-400 text-xs sm:text-sm max-w-xl mx-auto">
        Test your obscure scientific recall across chemistry, physics, and marine biology.
      </p>
    </div>

    <KrillionArena modeUrl="https://www.krillion.org/play/science/" />

    <!-- Editorial strategy section for SEO -->
    <section class="mt-12 p-8 rounded-3xl bg-abyss-card border border-white/5 space-y-4">
      <h2 class="text-xl font-bold text-white">Science 7,000m Strategy & Tips</h2>
      <p class="text-xs text-slate-300 leading-relaxed">
        Transition metal prompts: skip Gold, Iron, Copper (0m) and Tungsten/Titanium (3,000m trap). Score maximum depth with <em>Rhenium</em>, <em>Osmium</em>, <em>Iridium</em>, <em>Hafnium</em>, or <em>Technetium</em>.
      </p>
    </section>
  </div>
</Layout>
