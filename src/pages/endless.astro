---
import Layout from '../layouts/Layout.astro';
import KrillionArena from '../components/KrillionArena.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const officialUrl = 'https://krillion.io/unlimited/classic';
const practiceUrl = '/endless-game/index.html';
const breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'The Endless Dive' }];
const faqs = [
  ['What is The Endless Dive game?', 'The Endless Dive is the name shown on Krillion’s official Unlimited mode at krillion.io. This page also offers an independent Endless practice game that you can play here on Krillion.si.'],
  ['Is this the official Krillion Unlimited game?', 'No. Our practice game is adapted from the MIT-licensed OpenKrillion project. Its questions, accepted answers and practice scores are separate from the official game.'],
  ['Where can I play the official Endless Dive?', 'Open krillion.io/unlimited/classic, or select Unlimited in the menu at krillion.io. Official access and purchases are managed there.'],
  ['Is practice free, and do I need an account?', 'Practice here is free and requires no account. It runs in your browser, without an external judging service. When browser storage is available, your progress and last 30 practice dives are saved on this device.'],
  ['How many questions are available?', 'The practice bank has 42 finite categories. Each dive selects seven different prompts, using unseen categories first and reshuffling after the pool is used. Each category includes its complete standard answer list and common aliases, checked against the linked references.'],
  ['How does scoring work?', 'Each category uses preset scores until it has 50 first valid answers from anonymous browser identifiers. After that, observed answer frequencies determine its score tiers. Only your first accepted answer per category counts toward statistics. Daily snapshots refresh the scoring; each dive keeps the scores it started with. These are independent practice scores. Every point moves your dive ten metres.'],
  ['Can I retry an answer or resume a dive?', 'Yes. Unrecognized answers can be retried while the 25-second timer runs. Suggested spelling corrections require confirmation. Refreshing restores your dive when browser storage is available; the clock continues in background tabs. Opening the game menu pauses it.'],
  ['Does my practice score count toward the official game?', 'No. Practice scores stay separate from krillion.io. After seven prompts, you can review every accepted answer and start another dive here.']
];
const endlessFaqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(([question, answer]) => ({
    '@type': 'Question', name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer }
  }))
};
---

<Layout
  title="The Endless Dive Game — Krillion Unlimited Guide & Practice"
  description="Find the official Krillion Endless Dive, compare Unlimited with Daily Dive, or play a free seven-prompt practice game here. Complete answer lists, local progress and unlimited repeat dives."
  canonical="https://krillion.si/endless/"
  schema={endlessFaqSchema}
>
  <div class="py-6 px-3 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-6">
    <div class="space-y-3">
      <Breadcrumb items={breadcrumbs} />

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-2">
        <div class="space-y-1.5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-400 text-xs font-bold font-mono">
            <span>KRILLION UNLIMITED · INDEPENDENT GUIDE</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
            The Endless Dive: Krillion Unlimited
          </h1>
          <p class="text-slate-400 text-xs sm:text-sm max-w-2xl leading-relaxed">
            Looking for another dive after the daily challenge? The Endless Dive is the name of Krillion’s official Unlimited mode.
            Play our free practice game below, or open the original Unlimited mode at krillion.io.
          </p>
        </div>

        <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-center p-3 rounded-2xl bg-abyss-card border border-cyan-500/20 text-right">
          <span class="text-[10px] text-slate-400 font-mono uppercase tracking-wider">Two separate versions</span>
          <span class="text-sm font-black text-cyan-400">Official &amp; practice</span>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      <div class="flex flex-wrap gap-3">
        <a href="#practice" class="px-5 py-3 rounded-xl bg-cyan-400 text-slate-950 font-bold text-sm hover:bg-cyan-300">Play Endless practice ↓</a>
        <a href="https://endlessdive.com" target="_blank" rel="noopener" class="px-5 py-3 rounded-xl bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 font-bold text-sm hover:bg-emerald-500/30">Dedicated Arena: EndlessDive.com ↗</a>
        <a href={officialUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-3 rounded-xl border border-cyan-500/40 text-cyan-200 font-bold text-sm hover:bg-cyan-950">Open official Endless Dive ↗</a>
      </div>
      <p class="text-xs text-slate-400">Krillion.si is independent of krillion.io. Practice results and official progress are separate.</p>
    </div>

    <section id="practice" class="scroll-mt-24 space-y-3" aria-labelledby="practice-heading">
    <h2 id="practice-heading" class="text-xl font-bold text-white">Play Endless practice</h2>
    <p class="text-sm text-slate-400">Seven prompts per dive · 25 seconds per answer · 42 complete categories. New dives are free, with unseen categories first.</p>
    <KrillionArena modeUrl={practiceUrl} modeTitle="Krillion.si Endless practice game" badgeText="ENDLESS PRACTICE" statusText="PLAY ON KRILLION.SI" showHints={false} />
    <p class="text-xs text-slate-400 leading-relaxed">Each category starts with preset scores and switches to observed answer rarity at 50 first valid answers. One accepted answer per browser and category counts; anonymous answer IDs are sent to our statistics service. Dive progress stays in this browser. <a href="/privacy" class="text-cyan-300 underline">How statistics work</a>. Use Fullscreen for more room, or <a href={practiceUrl} target="_blank" rel="noopener noreferrer" class="text-cyan-300 underline">open the same game on its own page</a>.</p>
    <p class="text-xs text-slate-400">Built with <a href="https://github.com/VulcanEon/openkrillion.com-service" target="_blank" rel="noopener noreferrer" class="underline">OpenKrillion</a> · <a href="/endless-game/LICENSE.txt" target="_blank" rel="noopener noreferrer" class="underline">MIT license</a> · <a href="/endless-game/NOTICE.txt" target="_blank" rel="noopener noreferrer" class="underline">Credits</a></p>
    </section>

    <section class="p-6 rounded-3xl bg-abyss-card border border-white/10 space-y-3" aria-labelledby="about-heading">
      <h2 id="about-heading" class="text-2xl font-bold text-white">What is The Endless Dive?</h2>
      <p class="text-sm text-slate-300 leading-relaxed">At krillion.io, the menu link “Unlimited” opens a screen headed “THE ENDLESS DIVE,” with numbered dives and a Dive Log. It is the continuation mode for players who want to keep answering after the shared daily challenge, not a separate underwater action game.</p>
      <p class="text-sm text-slate-300 leading-relaxed">The aim is to find a valid answer beyond the most obvious choice. Read the <a href="/how-to-play" class="text-cyan-300 underline">basic Krillion rules</a>, then follow the instructions and timer shown by the version you are playing. A practice score is feedback, not a prediction of your official result.</p>
      <p class="text-xs text-slate-400">Practice bank reviewed <time datetime="2026-10-22">22 October 2026</time>. Sources are linked in each category’s answer review.</p>
    </section>

    <section class="space-y-4" aria-labelledby="compare-heading">
      <h2 id="compare-heading" class="text-2xl font-bold text-white">Daily Dive vs Endless Dive vs practice</h2>
      <div class="overflow-x-auto rounded-2xl border border-white/10">
        <table class="w-full min-w-[620px] text-left text-sm bg-abyss-card">
          <caption class="sr-only">The official daily and unlimited modes compared with Krillion.si practice.</caption>
          <thead class="bg-cyan-950/50 text-cyan-200"><tr><th scope="col" class="p-4">Version</th><th scope="col" class="p-4">Best for</th><th scope="col" class="p-4">Where to play</th><th scope="col" class="p-4">What to expect</th></tr></thead>
          <tbody class="divide-y divide-white/10 text-slate-300">
            <tr><th scope="row" class="p-4 text-white">Official Daily Dive</th><td class="p-4">The shared daily challenge</td><td class="p-4"><a href="https://krillion.io/" target="_blank" rel="noopener noreferrer" class="text-cyan-300 underline">krillion.io ↗</a></td><td class="p-4">The creator’s daily prompts and results.</td></tr>
            <tr><th scope="row" class="p-4 text-white">Official Endless Dive</th><td class="p-4">More rounds in the official game</td><td class="p-4"><a href={officialUrl} target="_blank" rel="noopener noreferrer" class="text-cyan-300 underline">Krillion Unlimited ↗</a></td><td class="p-4">Official questions, progress and access requirements.</td></tr>
            <tr><th scope="row" class="p-4 text-white">Practice on Krillion.si</th><td class="p-4">Category recall and repeat attempts</td><td class="p-4"><a href="#practice" class="text-cyan-300 underline">Play practice here ↑</a></td><td class="p-4">Our curated questions; preset scores below 50 first answers per category, observed rarity after that; no official score sync.</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Practice Strategy Notes -->
    <div class="p-6 rounded-3xl bg-abyss-card border border-white/10 space-y-3">
      <h2 class="text-xl font-bold text-white">Make each practice dive useful</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-slate-300">
        <div class="p-4 rounded-2xl bg-white/5 space-y-1">
          <h3 class="font-bold text-cyan-400">1. Read the whole category</h3>
          <p>A surprising answer still has to fit. Check dates, places and other restrictions before submitting.</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/5 space-y-1">
          <h3 class="font-bold text-cyan-400">2. Pick something you can explain</h3>
          <p>Try a less familiar answer you know is valid. Obscurity alone does not make an answer correct.</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/5 space-y-1">
          <h3 class="font-bold text-cyan-400">3. Review, then play again</h3>
          <p>Use feedback to expand your recall. Different editions can accept and score the same answer differently.</p>
        </div>
      </div>
    </div>
    <section class="space-y-4" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl font-bold text-white">The Endless Dive FAQ</h2>
      {faqs.map(([question, answer]) => (
        <details class="rounded-2xl border border-white/10 bg-abyss-card p-5">
          <summary class="cursor-pointer font-bold text-white text-sm">{question}</summary>
          <p class="mt-3 text-sm text-slate-300 leading-relaxed">{answer}</p>
        </details>
      ))}
    </section>
    <section class="border-t border-white/10 pt-6 space-y-3 text-sm" aria-labelledby="next-heading">
      <h2 id="next-heading" class="text-xl font-bold text-white">Choose your next dive</h2>
      <div class="flex flex-wrap gap-x-6 gap-y-3 text-cyan-300 underline"><a href="/daily">Daily practice</a><a href="/how-to-play">How to play</a><a href="/what-is">What is Krillion?</a><a href="/how-to-dive-7000m">Answer strategy</a></div>
      <p class="text-xs text-slate-400">Sources: <a href={officialUrl} target="_blank" rel="noopener noreferrer" class="underline">official Unlimited screen</a>, <a href="https://krillion.io/restore?pack=classic" target="_blank" rel="noopener noreferrer" class="underline">official unlock recovery</a>, <a href="https://krillion.io/faq" target="_blank" rel="noopener noreferrer" class="underline">creator’s FAQ</a>, and <a href="/endless-game/bank.mjs" target="_blank" rel="noopener noreferrer" class="underline">our practice category references</a>.</p>
    </section>
  </div>
</Layout>
