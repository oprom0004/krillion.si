---
import Layout from '../layouts/Layout.astro';
import KrillionArena from '../components/KrillionArena.astro';
---

<Layout
  title="Play Krillion Sports & Athletics Pack | Rare Sports Trivia - Krillion.si"
  description="Play Krillion's Sports & Athletics themed pack. Unearth obscure Olympic medalists, historical Champions League contenders, and forgotten athletic records."
>
  <div class="py-6 px-3 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-6">
    <div class="text-center space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/40 border border-cyan-500/30 text-abyss-cyan text-xs font-bold">
        <span>⚽ THEMED PACK • SPORTS & ATHLETICS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Krillion Sports & Athletics Pack
      </h1>
      <p class="text-slate-400 text-xs sm:text-sm max-w-xl mx-auto">
        Plunge past obvious superstar athletes and test your obscure international sporting recall.
      </p>
    </div>

    <KrillionArena modeUrl="https://www.krillion.org/play/sports/" />

    <!-- Editorial strategy section for SEO -->
    <section class="mt-12 p-8 rounded-3xl bg-abyss-card border border-white/5 space-y-4">
      <h2 class="text-xl font-bold text-white">Sports 7,000m Strategy & Tips</h2>
      <p class="text-xs text-slate-300 leading-relaxed">
        Avoid modern mainstream sports icons like Messi, Ronaldo, LeBron, or Usain Bolt. Look for historical Olympic gold medalists from smaller delegations, or pre-war football championships.
      </p>
    </section>
  </div>
</Layout>
