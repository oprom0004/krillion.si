---
import Layout from '../layouts/Layout.astro';
import KrillionArena from '../components/KrillionArena.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import IconMovie from '../components/icons/IconMovie.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Themed Packs', href: '/#variants' },
  { label: 'Cinema & Academy Awards' }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How is score calculated in the Krillion Cinema Pack?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In the Krillion Cinema Pack, each round prompts you with a film-related category (e.g., Best Picture Oscar Winners, Cannes Palme d'Or Laureates, Coen Brothers actors). Your depth is calculated by comparing your valid answer against all global player submissions. The fewer players who picked your answer, the deeper your dive (up to 1,000m per round)."
      }
    },
    {
      "@type": "Question",
      "name": "Why do popular blockbusters score low in Krillion Movies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Krillion is a reverse-trivia game. Submitting modern famous titles like 'Titanic', 'Oppenheimer', or 'Everything Everywhere All at Once' incurs massive crowd-overlap penalties, keeping your submarine near the surface (0m–200m)."
      }
    },
    {
      "@type": "Question",
      "name": "What are high-depth winning examples for Oscar Best Picture prompts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To achieve 900m+ hadal depth, target pre-1950s Academy Award winners such as 'Wings' (1927), 'The Broadway Melody' (1929), 'Cavalcade' (1933), 'The Life of Emile Zola' (1937), or 'Gentleman's Agreement' (1947)."
      }
    }
  ]
};
---

<Layout
  title="Krillion Cinema & Academy Awards Pack | Play Film Reverse Trivia Online"
  description="Play Krillion Movies & Oscars pack online for free. Plunge to 7,000m depth by naming obscure Academy Award winners, Cannes laureates, and vintage cinema classics."
  schema={faqSchema}
>
  <div class="py-6 px-3 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8">
    <!-- Breadcrumb & GEO Capsule Header -->
    <div class="space-y-3">
      <Breadcrumb items={breadcrumbs} />
      
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-2">
        <div class="space-y-1.5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-400 text-xs font-bold font-mono">
            <IconMovie class="w-3.5 h-3.5" />
            <span>THEMED VAULT • CINEMA & ACADEMY AWARDS</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
            Krillion Cinema & Oscars Pack
          </h1>
          <p class="text-slate-400 text-xs sm:text-sm max-w-3xl leading-relaxed">
            <strong class="text-white">Direct Definition:</strong> The Cinema Pack tests deep cinephile knowledge across Academy Awards, film festival laureates, and director filmographies. Reach 7,000m by avoiding commercial blockbusters and submitting valid vintage or auteur masterpieces.
          </p>
        </div>

        <!-- Quick Depth Badge -->
        <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-center p-3 rounded-2xl bg-abyss-card border border-cyan-500/20 text-right">
          <span class="text-[10px] text-slate-400 font-mono uppercase tracking-wider">Target Threshold</span>
          <span class="text-xl font-black text-cyan-400 font-mono">7,000m Trench</span>
        </div>
      </div>
    </div>

    <!-- Playable Game Viewport -->
    <KrillionArena
      modeUrl="https://www.krillion.org/play/movies/"
      modeTitle="Krillion Cinema & Oscars Pack"
      badgeText="CINEMA & OSCARS PACK 🎬"
    />

    <!-- SEO & GEO Editorial: Depth Matrix & Strategy -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 pt-4">
      <!-- Left 2 Cols: Stratagem & Rarity Matrix -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Rarity Matrix Table -->
        <div class="p-6 sm:p-8 rounded-3xl bg-abyss-card border border-white/10 space-y-5">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              <span>Cinema Rarity Matrix: Hadal vs Surface Answers</span>
            </h2>
            <span class="text-[11px] font-mono text-cyan-400/80 bg-cyan-950/50 px-2 py-0.5 rounded border border-cyan-500/20">Prompt: Best Picture Winners</span>
          </div>

          <p class="text-xs text-slate-300 leading-relaxed">
            In reverse trivia, common answers result in shallow dives. Study this sample frequency matrix to gauge answer depths:
          </p>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
              <thead>
                <tr class="border-b border-white/10 text-slate-400 font-mono">
                  <th class="py-2.5 px-3">Depth Zone</th>
                  <th class="py-2.5 px-3">Answer Examples</th>
                  <th class="py-2.5 px-3">Estimated Rarity</th>
                  <th class="py-2.5 px-3">Depth Yield</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5 font-mono">
                <tr class="bg-emerald-950/20 text-emerald-300">
                  <td class="py-3 px-3 font-bold">🌊 Hadal Trench</td>
                  <td class="py-3 px-3 font-sans"><em>Cavalcade (1933)</em>, <em>The Broadway Melody (1929)</em>, <em>Gentleman's Agreement (1947)</em></td>
                  <td class="py-3 px-3">&lt; 1.5%</td>
                  <td class="py-3 px-3 font-bold">+920m ~ 990m</td>
                </tr>
                <tr class="bg-cyan-950/20 text-cyan-300">
                  <td class="py-3 px-3 font-bold">⚓ Abyssal Zone</td>
                  <td class="py-3 px-3 font-sans"><em>Marty (1955)</em>, <em>The Lost Weekend (1945)</em>, <em>All the King's Men (1949)</em></td>
                  <td class="py-3 px-3">2.0% ~ 5.0%</td>
                  <td class="py-3 px-3 font-bold">+700m ~ 850m</td>
                </tr>
                <tr class="bg-amber-950/20 text-amber-300">
                  <td class="py-3 px-3 font-bold">⚠️ Bathyal Shelf</td>
                  <td class="py-3 px-3 font-sans"><em>The Artist (2011)</em>, <em>The English Patient (1996)</em>, <em>Platoon (1986)</em></td>
                  <td class="py-3 px-3">8.0% ~ 18.0%</td>
                  <td class="py-3 px-3 font-bold">+350m ~ 550m</td>
                </tr>
                <tr class="bg-rose-950/20 text-rose-300">
                  <td class="py-3 px-3 font-bold">🚨 Surface Trap</td>
                  <td class="py-3 px-3 font-sans"><em>Titanic (1997)</em>, <em>Oppenheimer (2023)</em>, <em>The Lord of the Rings (2003)</em></td>
                  <td class="py-3 px-3">&gt; 35%</td>
                  <td class="py-3 px-3 font-bold">0m ~ 120m</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3 Golden Rules -->
        <div class="p-6 sm:p-8 rounded-3xl bg-abyss-card border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            <span>3 Tactical Rules for Deep Film Dives</span>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
            <div class="p-4 rounded-2xl bg-white/5 border border-white/5 space-y-2">
              <span class="text-xs font-mono font-bold text-cyan-400">01. Vintage Advantage</span>
              <p class="text-xs text-slate-300 leading-relaxed">
                Most casual players only remember films released after 1990. Tapping the 1927–1955 era guarantees lower collision rates.
              </p>
            </div>
            <div class="p-4 rounded-2xl bg-white/5 border border-white/5 space-y-2">
              <span class="text-xs font-mono font-bold text-cyan-400">02. Verified Spelunking</span>
              <p class="text-xs text-slate-300 leading-relaxed">
                Ensure nominated films actually <em>won</em> the category. Guessing a classic nominee that lost yields 0m depth penalty.
              </p>
            </div>
            <div class="p-4 rounded-2xl bg-white/5 border border-white/5 space-y-2">
              <span class="text-xs font-mono font-bold text-cyan-400">03. Franchise Evading</span>
              <p class="text-xs text-slate-300 leading-relaxed">
                Avoid blockbuster intellectual properties (Marvel, Star Wars, Harry Potter) even in technical craft categories.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ Section for Search Engine Answer Boxes -->
        <div class="p-6 sm:p-8 rounded-3xl bg-abyss-card border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white">Frequently Asked Questions</h2>
          <div class="space-y-4 pt-2">
            {faqSchema.mainEntity.map(faq => (
              <div class="p-4 rounded-2xl bg-white/5 border border-white/5 space-y-2">
                <h3 class="text-sm font-bold text-cyan-300">{faq.name}</h3>
                <p class="text-xs text-slate-300 leading-relaxed">{faq.acceptedAnswer.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right 1 Col: Themed Packs Hub & Tools -->
      <div class="space-y-6">
        <!-- Sister Solver Banner -->
        <div class="p-6 rounded-3xl bg-gradient-to-br from-amber-950/40 via-abyss-card to-abyss-card border border-amber-500/30 space-y-3">
          <div class="flex items-center gap-2 text-amber-400 text-xs font-bold">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7Z"/><path d="M9 21h6"/></svg>
            <span>Stuck on Today's Dive?</span>
          </div>
          <h3 class="text-base font-bold text-white">KrillionHints.com Daily Solver</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Get progressive spoiler-free clues, validated rarity metrics, and candidate lists updated every midnight UTC.
          </p>
          <a
            href="https://krillionhints.com"
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs text-center transition-colors shadow-lg shadow-amber-500/20"
          >
            Access Daily Hints & Solver ↗
          </a>
        </div>

        <!-- All Other Themed Vaults -->
        <div class="p-6 rounded-3xl bg-abyss-card border border-white/10 space-y-3">
          <h3 class="text-sm font-bold text-white uppercase tracking-wider font-mono">Other Themed Packs</h3>
          <div class="space-y-2 text-xs">
            <a href="/geography" class="block p-2.5 rounded-xl bg-white/5 hover:bg-cyan-500/10 hover:text-cyan-400 border border-white/5 transition-all">
              🌍 Geography & Sovereign Enclaves
            </a>
            <a href="/history" class="block p-2.5 rounded-xl bg-white/5 hover:bg-cyan-500/10 hover:text-cyan-400 border border-white/5 transition-all">
              🏛️ World History & Empires
            </a>
            <a href="/sports" class="block p-2.5 rounded-xl bg-white/5 hover:bg-cyan-500/10 hover:text-cyan-400 border border-white/5 transition-all">
              ⚽ Sports & Olympic Champions
            </a>
            <a href="/language" class="block p-2.5 rounded-xl bg-white/5 hover:bg-cyan-500/10 hover:text-cyan-400 border border-white/5 transition-all">
              📖 Language & Literature Classics
            </a>
            <a href="/science" class="block p-2.5 rounded-xl bg-white/5 hover:bg-cyan-500/10 hover:text-cyan-400 border border-white/5 transition-all">
              🧪 Science & Periodic Elements
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
