---
import Layout from '../layouts/Layout.astro';
import KrillionArena from '../components/KrillionArena.astro';
---

<Layout
  title="Play Krillion Language & Literature Pack | Shakespeare & Etymology - Krillion.si"
  description="Play Krillion's Language & Literature themed pack. Test obscure Shakespearean folios, archaic vocabulary roots, and Nobel laureates in literature."
>
  <div class="py-6 px-3 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-6">
    <div class="text-center space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/40 border border-cyan-500/30 text-abyss-cyan text-xs font-bold">
        <span>📖 THEMED PACK • LANGUAGE & LITERATURE</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Krillion Language & Literature Pack
      </h1>
      <p class="text-slate-400 text-xs sm:text-sm max-w-xl mx-auto">
        Plunge past obvious classics and test your rare theatrical and literary knowledge.
      </p>
    </div>

    <KrillionArena modeUrl="https://www.krillion.org/play/language/" />

    <!-- Editorial strategy section for SEO -->
    <section class="mt-12 p-8 rounded-3xl bg-abyss-card border border-white/5 space-y-4">
      <h2 class="text-xl font-bold text-white">Language 7,000m Strategy & Tips</h2>
      <p class="text-xs text-slate-300 leading-relaxed">
        For Shakespeare, avoid <em>Hamlet</em> and <em>Macbeth</em> (0m), and beware the <em>Titus Andronicus</em> trap (3,000m). Dive to 7,000m with <em>Cymbeline</em>, <em>Pericles</em>, or <em>The Two Noble Kinsmen</em>.
      </p>
    </section>
  </div>
</Layout>
